# 웹에 존재해도 되는 값은 이 둘뿐이다. — CLAUDE.md 아키텍처 규칙 9
# Supabase → Project Settings → API 에서 가져온다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 운영 URL은 src/lib/site-url.ts의 PRODUCTION_URL에 박혀 있다 (https://meetnaon.vercel.app).
# 커스텀 도메인을 붙이면 그 파일 한 줄을 바꾸거나, 아래를 켜서 덮어쓴다.
# NEXT_PUBLIC_SITE_URL=https://meetnaon.vercel.app

# SUPABASE_SERVICE_ROLE_KEY · GEMINI_API_KEY · FAL_KEY 는 여기에 넣지 않는다.
# Supabase Edge Function 시크릿에만 둔다:
#   supabase secrets set GEMINI_API_KEY=... GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
#   supabase secrets set FAL_KEY=...   # 영상 변환(Wan-Animate)에만 쓴다
# 웹 코드에서 이 이름을 쓰는 순간 잘못된 방향으로 가고 있는 것이다.
