{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "_comment_exclude": "supabase/functions는 Deno에서 돈다. Deno 전역과 jsr:/https: import, .ts 확장자 import를 쓰기 때문에 Next의 tsconfig로 검사하면 전부 에러가 된다. 타입 검사는 `npx supabase functions deploy`(원격 번들)와 Deno가 맡는다.",
  "exclude": ["node_modules", "supabase/functions"]
}
